{
  "name": "webfetch-plus",
  "version": "0.1.0",
  "type": "module",
  "description": "Timeout-safe MCP server replacing Claude Code's built-in WebFetch",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "webfetch-plus": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfassaie/webfetch-plus.git"
  },
  "homepage": "https://github.com/mfassaie/webfetch-plus",
  "bugs": {
    "url": "https://github.com/mfassaie/webfetch-plus/issues"
  },
  "author": "Mehdi Fassaie",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webfetch",
    "web-scraping",
    "content-extraction",
    "claude-code"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "defuddle": "^0.15.0",
    "linkedom": "^0.18.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "mcp-testing-kit": "^0.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
