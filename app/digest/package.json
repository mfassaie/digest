{
  "name": "@mfassaie/digest",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server that fetches files into a structured artefact store, converts markdown and HTML to a typed section tree, and serves content through fetch_file, read_document, read_section, and write_section tools",
  "bin": {
    "digest": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfassaie/digest.git"
  },
  "homepage": "https://github.com/mfassaie/digest",
  "bugs": {
    "url": "https://github.com/mfassaie/digest/issues"
  },
  "author": "Mehdi Fassaie",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webfetch",
    "web-scraping",
    "content-extraction",
    "headless-browser",
    "claude-code",
    "mcp-server",
    "artefact-store"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "defuddle": "^0.19.2",
    "linkedom": "^0.18.13",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@digest/docker": "workspace:*",
    "@digest/mcp-server": "workspace:*",
    "@digest/shared": "workspace:*",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.28.0",
    "mcp-testing-kit": "0.2.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
