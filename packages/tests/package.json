{
  "name": "@digest/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repo test tooling: integration scripts and the converter eval harness",
  "scripts": {
    "test": "tsx integration/verify-dev.ts",
    "e2e": "tsx integration/e2e-host.ts",
    "verify:dev": "tsx integration/verify-dev.ts",
    "verify:docroot": "tsx integration/verify-docroot.ts",
    "capture": "tsx integration/capture-and-review.ts",
    "tooling-evals": "tsx tooling-evals/src/run-all.ts",
    "tooling-evals:score": "tsx tooling-evals/src/run-all.ts --score-only",
    "tooling-evals:real": "tsx tooling-evals/src/run-real.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "defuddle": "^0.15.0",
    "linkedom": "^0.18.12",
    "mdream": "^0.15.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2"
  }
}
