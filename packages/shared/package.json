{
  "name": "@digest/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared host-side core for digest: settings engine, artefact store, markdown engine (fold/splice/ids), fetch (HTTP + file), SWR freshness, chunking, HTML adapter, logging",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "default": "./src/settings/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/http-cache-semantics": "4.2.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^25.5.0",
    "@types/unist": "3.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "defuddle": "^0.15.0",
    "http-cache-semantics": "4.2.0",
    "linkedom": "^0.18.12",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  }
}
