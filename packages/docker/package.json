{
  "name": "@digest/docker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every Docker concern for digest: host-side container lifecycle and HTTP client, the in-container fetch/convert service, and the image build context",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@digest/shared": "workspace:*",
    "defuddle": "^0.15.0",
    "linkedom": "^0.18.12",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
