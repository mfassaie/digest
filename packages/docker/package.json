{
  "name": "@digest/docker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every Docker concern for digest: host-side container lifecycle and HTTP client, the in-container fetch/convert service, and the image build context",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@digest/shared": "workspace:*",
    "defuddle": "^0.19.1",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
