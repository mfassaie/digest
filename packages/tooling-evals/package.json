{
  "name": "@digest/tooling-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTML-to-Markdown converter eval harness for digest",
  "scripts": {
    "all": "tsx src/run-all.ts",
    "score": "tsx src/run-all.ts --score-only",
    "real": "tsx src/run-real.ts",
    "capture": "tsx capture.ts",
    "test:coverage": "node -e \"console.log('no unit tests here: eval harness only')\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "defuddle": "^0.15.0",
    "linkedom": "^0.18.12",
    "mdream": "^1.4.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@digest/docker": "workspace:*",
    "@digest/mcp-server": "workspace:*",
    "@digest/shared": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2"
  }
}
