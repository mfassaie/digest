# Manual integration test: builds the local image and exercises the
# container against live URLs. NEVER pushes the image (CloakBrowser binary
# licence forbids redistribution). Manual only — the base image pull is heavy.
name: Container integration

on:
  workflow_dispatch:

jobs:
  integration:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile
        env:
          PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'

      - name: Build service bundle
        run: pnpm --filter @digest/fetch-service build

      - name: Build local image (never pushed)
        run: docker build -t digest:local packages/digest/docker

      - name: Build host
        run: pnpm build

      - name: Run end-to-end against the live container
        run: pnpm dlx tsx packages/e2e/e2e-host.ts
